<%- include('partials/header') %>

<article class="page puzzle">
  <h1 class="puzzle-title"></h1>

  <section class="story-box" aria-label="Story so far">
    <p class="story-text"></p>
  </section>

  <section class="prompt-box" aria-label="Puzzle">
    <h2>The Puzzle</h2>
    <p class="prompt-text"><%= questionText %></p>
  </section>

  <section class="error-box">
    <p class="error-message"></p>
  </section>

  <form method="POST" class="answer-form">
    <label for="answer">Your answer</label>
    <input type="text" id="answer" name="answer" value="" required maxlength="100" autofocus>
    <button type="submit">Submit</button>
  </form>

</article>

<%- include('partials/footer') %>